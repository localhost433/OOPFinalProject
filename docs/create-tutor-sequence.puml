@startuml create-tutor-sequence
' Sequence diagram — Admin creates a tutor profile (Main.createTutor)

actor Admin as admin

participant "Main" as main
participant "SystemManager" as sys
participant "t : Tutor" as tObj
participant "FileManager" as file

admin -> main : createTutor(name, password, subject)
activate admin
activate main

main -> sys : findTutor(name)
activate sys
sys --> main : t
deactivate sys
deactivate admin

main -> tObj ** : new Tutor(name, password, subject)

main -> sys : addTutor(t)
activate sys
deactivate sys

main -> sys : save()
activate sys
sys -> file : saveData()
activate file
deactivate file
deactivate sys

deactivate main

@enduml
