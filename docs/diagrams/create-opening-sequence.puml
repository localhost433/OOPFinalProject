@startuml create-opening-sequence
' Sequence diagram — Tutor adds availability (Main.createOpening)

hide footbox

actor Tutor as tutor

participant "Main" as main
participant "service : AppointmentService" as service
participant "t : Tutor" as tObj
participant "o : Opening" as open
participant "SystemManager" as sys
participant "FileManager" as file

tutor -> main : createOpening(start, end, date, t)
activate main

main -> service : createOpening(start, end, date, t)
activate service

service -> open ** : new Opening(start, end, date, t)

service -> tObj : hasConflict(o)
activate tObj
tObj --> service : true / false
deactivate tObj

alt hasConflict(o) == true
    service --> main : Result.TIME_CONFLICT
    main -> tutor : "You already have an opening at this time."
else hasConflict(o) == false
    service -> tObj : addOpening(o)
    activate tObj
    deactivate tObj

    service -> sys : addOpening(o)
    activate sys
    deactivate sys

    service -> sys : save()
    activate sys
    sys -> file : saveData(allStudents, allTutors, allOpenings)
    activate file
    deactivate file
    deactivate sys

    service --> main : Result.OK
end

deactivate service
deactivate main

@enduml
