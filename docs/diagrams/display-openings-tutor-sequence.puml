@startuml display-openings-tutor-sequence
' Sequence diagram — Display openings for tutor (Main.displayOpeningsForTutor)

hide footbox

actor Tutor as tutor

participant "Main" as main
participant "service : AppointmentService" as service
participant "t : Tutor" as tObj
participant "o : Opening" as open

tutor -> main : displayOpeningsForTutor(t)
activate main

main -> service : openingsForTutor(t)
activate service

service -> tObj : getAllOpenings()
activate tObj
tObj --> service : allOps
deactivate tObj

service --> main : allOps
deactivate service

loop for each Opening o in allOps
    main -> open : toString()
    activate open
    open --> main : text
    deactivate open

    main -> tutor : opening details
end

deactivate main

@enduml
