@startuml search-openings-sequence
' Sequence diagram — Student searches for available openings (Main.searchOpenings)

hide footbox

actor Student as student

participant "Main" as main
participant "service : AppointmentService" as service
participant "SystemManager" as sys
participant "o : Opening" as open

student -> main : searchOpenings(start, subject, date)
activate main

main -> service : searchOpenings(start, subject, date)
activate service

service -> sys : searchOpenings(start, subject, date)
activate sys
sys --> service : results
deactivate sys

service --> main : results
deactivate service

alt results.isEmpty() == true
    main -> student : "No openings match that subject, date, and time."
else results.isEmpty() == false
    loop for each Opening o in results
        main -> open : toString()
        activate open
        open --> main : text
        deactivate open

        main -> student : opening details
    end
end

deactivate main

@enduml
