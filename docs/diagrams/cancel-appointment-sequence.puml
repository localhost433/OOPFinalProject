@startuml cancel-appointment-sequence
' Sequence diagram — Student cancels an opening (Main.cancelApp)

actor Student as student

participant "Main" as main
participant "SystemManager" as sys
participant "o : Opening" as open
participant "booked : Student" as bObj
participant "s : Student" as sObj
participant "FileManager" as file

student -> main : cancelApp(s, ID)
activate main

main -> sys : getOpen(ID)
activate sys
sys --> main : o
deactivate sys

alt o == null
    main -> student : "No such Opening has been booked by you"
else o != null
    main -> open : getStudent()
    activate open
    open --> main : booked / null
    deactivate open

    alt booked == null
        main -> student : "No such Opening has been booked by you"
    else booked != null
        main -> bObj : getName()
        activate bObj
        bObj --> main : bookedName
        deactivate bObj

        main -> sObj : getName()
        activate sObj
        sObj --> main : name
        deactivate sObj

        alt bookedName.equals(name) == false
            main -> student : "No such Opening has been booked by you"
        else bookedName.equals(name) == true
            main -> open : setStudent(null)
            activate open
            deactivate open

            main -> sObj : removeBooking(ID)
            activate sObj
            deactivate sObj

            main -> sys : save()
            activate sys
            sys -> file : saveData(allStudents, allTutors, allOpenings)
            activate file
            deactivate file
            deactivate sys
        end
    end
end

deactivate main

@enduml
