@startuml cancel-appointment-sequence
' Sequence diagram — Student cancels an opening (Main.cancelApp)

hide footbox

actor Student as student

participant "Main" as main
participant "service : AppointmentService" as service
participant "SystemManager" as sys
participant "o : Opening" as open
participant "booked : Student" as bObj
participant "s : Student" as sObj
participant "FileManager" as file

student -> main : cancelApp(s, ID)
activate main

main -> service : cancelAppointment(s, ID)
activate service

service -> sys : getOpen(ID)
activate sys
sys --> service : o
deactivate sys

alt o == null
    service --> main : Result.NOT_BOOKED_BY_YOU
    main -> student : "No such Opening has been booked by you"
else o != null
    service -> open : getStudent()
    activate open
    open --> service : booked / null
    deactivate open

    alt booked == null
        service --> main : Result.NOT_BOOKED_BY_YOU
        main -> student : "No such Opening has been booked by you"
    else booked != null
        service -> bObj : getName()
        activate bObj
        bObj --> service : bookedName
        deactivate bObj

        service -> sObj : getName()
        activate sObj
        sObj --> service : name
        deactivate sObj

        alt bookedName.equals(name) == false
            service --> main : Result.NOT_BOOKED_BY_YOU
            main -> student : "No such Opening has been booked by you"
        else bookedName.equals(name) == true
            service -> open : setStudent(null)
            activate open
            deactivate open

            service -> sObj : removeBooking(ID)
            activate sObj
            deactivate sObj

            service -> sys : save()
            activate sys
            sys -> file : saveData(allStudents, allTutors, allOpenings)
            activate file
            deactivate file
            deactivate sys

            service --> main : Result.OK
        end
    end
end

deactivate service
deactivate main

@enduml
