@startuml book-appointment-sequence
' Sequence diagram — Student books an opening (Main.bookApps)

hide footbox

actor Student as student

participant "Main" as main
participant "service : AppointmentService" as service
participant "SystemManager" as sys
participant "o : Opening" as open
participant "s : Student" as sObj
participant "FileManager" as file

student -> main : bookApps(s, ID)
activate main

main -> service : bookAppointment(s, ID)
activate service

service -> sys : getOpen(ID)
activate sys
sys --> service : o
deactivate sys

alt o == null
    service --> main : Result.NO_SUCH_OPENING
    main -> student : "No such Opening"
else o != null

    service -> open : isAvailable()
    activate open
    open --> service : true / false
    deactivate open

    alt isAvailable() == false
        service --> main : Result.NOT_AVAILABLE
        main -> student : "not open"
    else isAvailable() == true

        service -> sObj : checkBookings(ID)
        activate sObj
        sObj --> service : true / false
        deactivate sObj

        alt checkBookings(ID) == true
            service --> main : Result.ALREADY_BOOKED
            main -> student : "You already booked this opening"
        else checkBookings(ID) == false

            service -> sObj : hasConflict(o)
            activate sObj
            sObj --> service : true / false
            deactivate sObj

            alt hasConflict(o) == true
                service --> main : Result.TIME_CONFLICT
                main -> student : "You already have a booking at this time."
            else hasConflict(o) == false

                service -> open : setStudent(s)
                activate open
                deactivate open

                service -> sObj : addOpening(o)
                activate sObj
                deactivate sObj

                service -> sys : save()
                activate sys
                sys -> file : saveData(allStudents, allTutors, allOpenings)
                activate file
                deactivate file
                deactivate sys

                service --> main : Result.OK
            end
        end
    end
end

deactivate service
deactivate main

@enduml
