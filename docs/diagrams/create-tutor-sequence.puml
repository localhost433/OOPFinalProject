@startuml create-tutor-sequence
' Sequence diagram — Administrator adds a tutor (Main.createTutor)

hide footbox

actor Administrator as administrator

participant "Main" as main
participant "service : AppointmentService" as service
participant "SystemManager" as sys
participant "t : Tutor" as tObj
participant "FileManager" as file

administrator -> main : createTutor(name, password, subject)
activate main

main -> service : createTutor(name, password, subject)
activate service

service -> sys : findTutor(name)
activate sys
sys --> service : t / null
deactivate sys

alt t != null
    service --> main : Result.DUPLICATE_NAME
    main -> administrator : "A tutor named <name> already exists."
else t == null
    service -> tObj ** : new Tutor(name, password, subject)

    service -> sys : addTutor(t)
    activate sys
    deactivate sys

    service -> sys : save()
    activate sys
    sys -> file : saveData(allStudents, allTutors, allOpenings)
    activate file
    deactivate file
    deactivate sys

    service --> main : Result.OK
end

deactivate service
deactivate main

@enduml
