@startuml create-opening-sequence
' Sequence diagram — Tutor creates an opening (Main.createOpening)

actor Tutor as tutor

participant "Main" as main
participant "t : Tutor" as tObj
participant "o : Opening" as open
participant "SystemManager" as sys
participant "FileManager" as file

tutor -> main : createOpening(start, end, date, t)
activate tutor
activate main
deactivate tutor

main -> open ** : new Opening(start, end, date, t)

main -> tObj : hasConflict(o)
activate tObj
tObj --> main : conflict
deactivate tObj

main -> tObj : addOpening(o)
activate tObj
deactivate tObj

main -> sys : addOpening(o)
activate sys
deactivate sys

main -> sys : save()
activate sys
sys -> file : saveData()
activate file
deactivate file
deactivate sys

deactivate main

@enduml
