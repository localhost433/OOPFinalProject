@startuml use-case-diagram
' Use case diagram — Tutoring Center Appointment Manager

actor Student as student
actor Tutor as tutor
actor Admin as admin

rectangle "Tutoring Center Appointment Manager" {
  usecase searchOpen    as "Search openings"
  usecase displayStudent as "Display openings for student"
  usecase bookApp       as "Book appointment"
  usecase cancelApp     as "Cancel appointment"

  usecase createOpening as "Create opening"
  usecase displayTutor  as "Display openings for tutor"

  usecase createStudent as "Create student"
  usecase createTutor   as "Create tutor"
}

student --> searchOpen
student --> displayStudent

tutor --> createOpening
tutor --> displayTutor

admin --> createStudent
admin --> createTutor

bookApp   ..> searchOpen  : <<extend>>
cancelApp ..> displayStudent : <<extend>>

@enduml
